{
   "manifest_version": 3,
   "name": "Tag Grabber",
   "description": "Adds a button that displays a YouTube video's keywords/tags and copies them when clicked",
   "version": "1.0.0",
   "content_scripts": [
      {
         "js": [
            "scripts/tagGrab.js"
         ],
         "matches": [
            "https://www.youtube.com/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "icons": {
      "16": "icons/tagGrab-16.png",
      "32": "icons/tagGrab-32.png",
      "48": "icons/tagGrab-48.png",
      "128": "icons/tagGrab-128.png"
   }
}